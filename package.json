{
  "name": "denden-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "BSD-3-Clause",
  "scripts": {
    "validate:data": "tsx src/cli/validate-data.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsx src/cli/build.ts",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "check:openapi": "tsx src/cli/check-openapi.ts",
    "db:load": "tsx src/cli/load-d1.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "hono": "^4.13.19",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
